local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local successInv, invModule = pcall(function()
    return require(LocalPlayer.PlayerScripts.Ui.inventory)
end)

local function returnToLobby()
    print("[Inventory Guard]: กำลังส่งตัวกลับลอบบี้...")
    pcall(function()
        ReplicatedStorage.remotes.reloadInvy:InvokeServer()
    end)
    task.wait(0.2)
    pcall(function()
        ReplicatedStorage.remotes.ReturnToLobbyEvent:FireServer()
    end)
end

if PlayerGui:FindFirstChild("InventoryGuardGUI") then
    PlayerGui:FindFirstChild("InventoryGuardGUI"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "InventoryGuardGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = PlayerGui

local CounterFrame = Instance.new("Frame")
CounterFrame.Size = UDim2.new(0, 220, 0, 60)
CounterFrame.Position = UDim2.new(1, -235, 0, 15)
CounterFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 26)
CounterFrame.BorderSizePixel = 0
CounterFrame.Parent = ScreenGui

Instance.new("UICorner", CounterFrame).CornerRadius = UDim.new(0, 8)
local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(100, 200, 255)
Stroke.Thickness = 1.5
Stroke.Parent = CounterFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 18)
TitleLabel.Position = UDim2.new(0, 0, 0, 4)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "🛡️ Inventory Guard (>= 250)"
TitleLabel.TextColor3 = Color3.fromRGB(150, 150, 180)
TitleLabel.TextSize = 11
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = CounterFrame

-- ระบบลาก UI (Draggable)
local dragging, dragInput, dragStart, startPos
TitleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = CounterFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleLabel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        CounterFrame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

local ValueLabel = Instance.new("TextLabel")
ValueLabel.Size = UDim2.new(1, 0, 0, 18)
ValueLabel.Position = UDim2.new(0, 0, 0, 20)
ValueLabel.BackgroundTransparency = 1
ValueLabel.Text = "กำลังโหลด..."
ValueLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
ValueLabel.TextSize = 12
ValueLabel.Font = Enum.Font.GothamBold
ValueLabel.Parent = CounterFrame

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 18)
StatusLabel.Position = UDim2.new(0, 0, 0, 38)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "สถานะ: กำลังตรวจสอบ..."
StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
StatusLabel.TextSize = 11
StatusLabel.Font = Enum.Font.GothamBold
StatusLabel.Parent = CounterFrame

local function getInventoryCount()
    if not successInv or not invModule then
        successInv, invModule = pcall(function()
            return require(LocalPlayer.PlayerScripts.Ui.inventory)
        end)
        if not successInv then return 0 end
    end

    local success, myInventory = pcall(function()
        return invModule.GetPlayerInvy()
    end)
    
    if not success or not myInventory then return 0 end

    local totalCount = 0
    for catKey, catData in pairs(myInventory) do
        if type(catData) == "table" then
            for _, _ in pairs(catData) do
                totalCount = totalCount + 1
            end
        end
    end
    return totalCount
end

local function checkInventory()
    local currentItems = getInventoryCount()
    local maxCapacity = 300
    
    ValueLabel.Text = string.format("%d / %d ชิ้น", currentItems, maxCapacity)
    
    if currentItems >= 250 then
        StatusLabel.Text = "สถานะ: 🚀 กำลังกลับลอบบี้..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        print("[Inventory Guard]: ของถึง " .. currentItems .. " ชิ้นแล้ว (>= 250) -> สั่งกลับลอบบี้ทันที!")
        returnToLobby()
        task.wait(10) -- หน่วงเวลาไม่ให้ส่งซ้ำรัวๆ ระหว่างย้ายแมพ
    else
        StatusLabel.Text = "สถานะ: ⏳ ยังไม่พร้อม (< 250)"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
        print("[Inventory Guard]: ของมี " .. currentItems .. " ชิ้น -> ยังไม่ถึงเกณฑ์ [ยังไม่พร้อม]")
    end
end

task.spawn(function()
    while true do
        checkInventory()
        task.wait(2)
    end
end)
