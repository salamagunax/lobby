-- ฟังก์ชันเช็คจำนวนของสมมติจาก UI หรือกระเป๋าจริง
local function GetCurrentItemCount()
    -- ตรงนี้พยายามดึงค่าตัวเลขจาก UI เดิม หรือนับจากช่องเก็บของจริง
    -- เนื่องจากปัจจุบันมี 59/300 ฟังก์ชันนี้จะรีเทิร์นค่าปัจจุบันออกมา
    return 59 -- ตัวอย่างจำลองตามที่คุณแจ้งว่าตอนนี้คือ 59
end

ForceStartBtn.MouseButton1Click:Connect(function()
    local currentCount = GetCurrentItemCount()
    if currentCount < 10 then
        StatusLabel.Text = "✅ ของในกระเป๋า ("..currentCount.."/300) ผ่านเกณฑ์ (< 10) กำลังจอย..."
        pcall(function()
            for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                    local name = remote.Name:lower()
                    if name:find("dungeon") or name:find("room") or name:find("start") or name:find("outpost") then
                        pcall(function()
                            if remote:IsA("RemoteEvent") then
                                remote:FireServer("Winter Outpost", "Nightmare")
                            else
                                remote:InvokeServer("Winter Outpost", "Nightmare")
                            end
                        end)
                    end
                end
            end
        end)
    else
        StatusLabel.Text = "⛔ ของมี " .. currentCount .. "/300 ชิ้น (เกิน 10 ชิ้น) ไม่อนุญาตให้จอยตามเงื่อนไข!"
    end
end)

local AutoRunning = false
AutoGuardBtn.MouseButton1Click:Connect(function()
    AutoRunning = not AutoRunning
    if AutoRunning then
        AutoGuardBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
        AutoGuardBtn.Text = "⏹ AUTO GUARD: STOP"
        StatusLabel.Text = "🟢 เริ่มระบบออโต้ [เช็คเงื่อนไข 0-9 ชิ้น]"
        
        task.spawn(function()
            while AutoRunning do
                local currentCount = GetCurrentItemCount()
                if currentCount < 10 then
                    StatusLabel.Text = "✅ ของผ่านเกณฑ์ ("..currentCount.."/300) กำลังลุย..."
                    pcall(function()
                        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                            if remote:IsA("RemoteEvent") and (remote.Name:lower():find("dungeon") or remote.Name:lower():find("start")) then
                                remote:FireServer()
                            end
                        end
                    end)
                else
                    StatusLabel.Text = "⏳ จอด่านรอ: ของมี " .. currentCount .. "/300 (ต้องเหลือน้อยกว่า 10 ถึงจะจอย)"
                end
                task.wait(3)
            end
        end)
    else
        AutoGuardBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 70)
        AutoGuardBtn.Text = "🔄 AUTO GUARD: CONDITIONAL"
        StatusLabel.Text = "⏹ หยุดระบบออโต้แล้ว"
    end
end)

