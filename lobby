local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local inventorySpaceLabel = nil

-- ฟังก์ชันค้นหา Label ช่องกระเป๋าแบบปลอดภัย
local function findInventoryLabel()
    local success = pcall(function()
        inventorySpaceLabel = PlayerGui:WaitForChild("inventory", 1)
            :WaitForChild("mainBackground", 1)
            :WaitForChild("innerBackground", 1)
            :WaitForChild("rightSideFrame", 1)
            :WaitForChild("inventorySpace", 1)
    end)
    return success and inventorySpaceLabel ~= nil
end

local function returnToLobby()
    pcall(function()
        ReplicatedStorage.remotes.reloadInvy:InvokeServer()
    end)
    task.wait(0.2)
    pcall(function()
        ReplicatedStorage.remotes.ReturnToLobbyEvent:FireServer()
    end)
end

if PlayerGui:FindFirstChild("InventoryGuardGUI") then
    PlayerGui:FindFirstChild("InventoryGuardGUI"):Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "InventoryGuardGUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = PlayerGui

local CounterFrame = Instance.new("Frame")
CounterFrame.Size = UDim2.new(0, 220, 0, 55)
CounterFrame.Position = UDim2.new(1, -235, 0, 15)
CounterFrame.BackgroundColor3 = Color3.fromRGB(16, 16, 26)
CounterFrame.BorderSizePixel = 0
CounterFrame.Parent = ScreenGui

Instance.new("UICorner", CounterFrame).CornerRadius = UDim.new(0, 8)
local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(100, 200, 255)
Stroke.Thickness = 1.5
Stroke.Parent = CounterFrame

local TitleLabel = Instance.new("TextLabel")
TitleLabel.Size = UDim2.new(1, 0, 0, 18)
TitleLabel.Position = UDim2.new(0, 0, 0, 4)
TitleLabel.BackgroundTransparency = 1
TitleLabel.Text = "🛡️ Inventory Guard (== 250)"
TitleLabel.TextColor3 = Color3.fromRGB(150, 150, 180)
TitleLabel.TextSize = 11
TitleLabel.Font = Enum.Font.GothamBold
TitleLabel.Parent = CounterFrame

-- ระบบลาก UI (Draggable)
local dragging, dragInput, dragStart, startPos
TitleLabel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = CounterFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleLabel.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        CounterFrame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

local ValueLabel = Instance.new("TextLabel")
ValueLabel.Size = UDim2.new(1, 0, 0, 24)
ValueLabel.Position = UDim2.new(0, 0, 0, 22)
ValueLabel.BackgroundTransparency = 1
ValueLabel.Text = "กำลังค้นหาช่องกระเป๋า..."
ValueLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
ValueLabel.TextSize = 13
ValueLabel.Font = Enum.Font.GothamBold
ValueLabel.Parent = CounterFrame

local function checkInventory()
    if not inventorySpaceLabel or not inventorySpaceLabel.Parent then
        if not findInventoryLabel() then
            ValueLabel.Text = "กำลังรอเปิดกระเป๋า..."
            ValueLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            return
        end
    end

    if inventorySpaceLabel and inventorySpaceLabel:IsA("TextLabel") then
        local text = inventorySpaceLabel.Text
        ValueLabel.Text = text
        
        local numbers = {}
        for numStr in text:gmatch("%d+") do
            table.insert(numbers, tonumber(numStr))
        end
        
        if #numbers >= 2 then
            local currentItems = numbers[1]
            local maxCapacity = numbers[2]
            
            -- เงื่อนไข: ถ้าของเท่ากับ 250 เป๊ะๆ ให้กลับลอบบี้
            if currentItems == 250 then
                ValueLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                ValueLabel.Text = text .. " (== 250! กลับลอบบี้)"
                returnToLobby()
                task.wait(10)
            else
                ValueLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
            end
        end
    end
end

-- เชื่อมต่อ Event อัปเดตข้อความทันทีเมื่อข้อความในเกมเปลี่ยน
task.spawn(function()
    while true do
        if inventorySpaceLabel and inventorySpaceLabel:IsA("TextLabel") then
            pcall(function()
                inventorySpaceLabel:GetPropertyChangedSignal("Text"):Connect(function()
                    checkInventory()
                end)
            end)
            break
        end
        findInventoryLabel()
        task.wait(1)
    end
end)

-- ลูปเช็คสถานะสม่ำเสมอ ป้องกันหลุดการทำงาน
task.spawn(function()
    while true do
        task.wait(2)
        checkInventory()
    end
end)
